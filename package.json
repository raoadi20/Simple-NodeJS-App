{
  "name": "my-todolist",
  "version": "0.1.0",
  "dependencies": {
    "body-parser": "^1.16.0",
    "ejs": "^2.5.5",
    "express": "^4.14.0",
    "method-override": "^3.0.0",
    "sanitizer": "^0.1.3",
    "jest-sonar-reporter": "^2.0.0"
  },
  "scripts": {
    "start:dev": "node app.js",
    "test:dev": "jest --coverage"
  },
